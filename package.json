{
  "name": "yume",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=./server server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "build:reamer": "vite build --config vite.reamer.config.mjs && node scripts/rename-reamer-index.mjs",
    "build:business": "vite build --config vite.business.config.mjs && node scripts/rename-business-index.mjs",
    "start:reamer": "serve dist-reamer -s -l ${PORT:-3000}",
    "test:legal": "node server/legalPipeline.test.js",
    "test:accuracy": "node server/tests/accuracy.js",
    "test": "node --test \"server/tests/*.test.js\"",
    "cap:sync": "cap sync"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@electric-sql/pglite": "^0.5.8",
    "@portone/browser-sdk": "^0.1.11",
    "@portone/server-sdk": "^0.19.0",
    "@tailwindcss/postcss": "^4.3.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.5.0",
    "framer-motion": "^11.11.17",
    "motion": "^13.2.0",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "^14.2.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "vite": "^5.4.10"
  }
}
