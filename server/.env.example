# ── 필수 ──
ANTHROPIC_API_KEY=
# 법제처 국가법령정보 공동활용 OC 코드
LAW_OC=
CLAUDE_MODEL=claude-sonnet-5
PORT=8787
NODE_ENV=production

# ── DB: Supabase(PostgreSQL) ──
# Supabase 프로젝트 → Connect → "Session pooler" 연결 문자열(포트 5432). [YOUR-PASSWORD]를 DB 비밀번호로 바꿔 넣는다.
# Transaction pooler(6543)는 쓰지 말 것(세션 설정이 유지되지 않음). 비워두면 로컬 PGlite(data/pglite)에 저장 — 개발용.
DATABASE_URL=
# 선택: Supabase 대시보드에서 받은 CA 인증서(PEM, 줄바꿈은 \n)를 넣으면 TLS 인증서까지 검증한다.
DATABASE_CA_CERT=
# 개인정보처리방침에 표시할 DB 저장 위치(예: 대한민국 서울 리전)
DB_REGION_LABEL=

# 공개 도메인 — 카카오 결과 링크, 비밀번호 재설정 메일, 데이터셋 다운로드 링크에 쓰인다.
PUBLIC_BASE_URL=https://www.yume-reamer.com

# ── 관리자 ──
# 이 이메일로 가입·로그인한 계정이 운영 대시보드(/admin) 권한을 받는다. 쉼표로 여러 개.
ADMIN_EMAILS=reamer@d-reamer.com
# 스크립트에서 X-Admin-Key 헤더로 관리자 API를 부를 때만 쓰는 비밀값(충분히 긴 무작위 문자열).
ADMIN_SECRET=

# ── 메일 (비밀번호 재설정) ──
# Resend(resend.com)에서 도메인 인증 후 발급. 비워두면 메일 대신 서버 콘솔에만 링크가 찍힌다.
RESEND_API_KEY=
MAIL_FROM=유메 <no-reply@yume-reamer.com>

# ── 데이터셋 ──
# 데이터셋 레코드 ID(가명)를 만드는 비밀 솔트. 한 번 정하면 바꾸지 말 것(바꾸면 구매처의 중복 제거가 깨짐).
DATASET_SALT=

# ── 사업자 정보 (약관·푸터 표시용, 비워두면 해당 줄 생략) ──
COMPANY_NAME=리머(REAMER)
COMPANY_CEO=정원영
COMPANY_EMAIL=reamer@d-reamer.com
BUSINESS_REG_NO=
BUSINESS_ADDRESS=
MAIL_ORDER_NO=

# ── 쿠팡파트너스 (선택) ──
# partners.coupang.com "Open API 이용신청"에서 발급. 비워두면 관련 상품은 일반 쿠팡 검색 링크로 나간다.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 쿠키 세션 API를 다른 도메인에서 호출해야 할 때만(쉼표 구분 host). 보통 비워둔다.
ALLOWED_ORIGINS=

# ── 카카오톡 채널 스킬 ──
# 무작위 문자열로 정하고, 카카오 i 오픈빌더 스킬 설정의 헤더에 X-Yume-Skill-Token: <같은 값>을 추가한다.
# 운영(NODE_ENV=production)에서 비워두면 스킬 요청을 받지 않는다.
KAKAO_SKILL_SECRET=
