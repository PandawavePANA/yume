ANTHROPIC_API_KEY=
LAW_OC=
CLAUDE_MODEL=claude-sonnet-5
PORT=8787
# 배포 도메인 (카카오톡 스킬 콜백이 "/r/:id" 대시보드 링크를 만들 때 씀).
# 비워두면 요청이 들어온 host를 그대로 쓰지만, Railway 등 프록시 뒤에서는
# 실제 공개 도메인으로 명시해주는 게 안전하다.
PUBLIC_BASE_URL=
# 쿠팡파트너스(partners.coupang.com) 가입 후 "Open API 이용신청" 메뉴에서 발급받는
# 키 두 개. 비워두면 "관련 상품" 링크는 그냥 일반 쿠팡 검색 링크로 나가고,
# 채워넣으면 자동으로 파트너스 추적 링크로 바뀐다(server/coupang.js).
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# /admin 관리자 대시보드 로그인 키. 직접 아무 문자열이나 정해서 채워두면 서버
# 재시작해도 그대로 유지된다. 비워두면 서버가 뜰 때마다 임시 키를 하나 만들어
# 콘솔에 출력한다(재배포 때마다 바뀜 — 로컬 확인용으로만 편함).
ADMIN_SECRET=
